# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL="https://example.org.uk"

# --- Sanity (leave blank to run the site from local seed content) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-01-01"

# Server-only token for draft preview / revalidation
SANITY_API_READ_TOKEN=""

# Shared secret for the revalidation webhook (/api/revalidate)
SANITY_REVALIDATE_SECRET=""

# --- Forms (Web3Forms access key, or a Resend API key if we self-host the handler) ---
WEB3FORMS_ACCESS_KEY=""
RESEND_API_KEY=""
ENQUIRY_TO_EMAIL=""

# --- Analytics (optional, cookieless) ---
NEXT_PUBLIC_VERCEL_ANALYTICS="false"
